{
    "appid": "4e9c768b-5401-41bd-bbbb-493aac0d3d03",
    "name": "EfficientIP DDI (Classic)",
    "description": "Analyst-driven IP/DNS lookup enrichment against an EfficientIP SOLIDserver DDI backend reached through an APIM gateway. Classic BaseConnector twin of the SDK-based efficientip_ddi app, built for side-by-side airgapped comparison -- same actions, same auth model, same corrected field names.",
    "type": "ddi",
    "product_vendor": "EfficientIP",
    "product_name": "SOLIDserver",
    "product_version_regex": ".*",
    "logo": "logo.svg",
    "logo_dark": "logo_dark.svg",
    "publisher": "Ted",
    "license": "Copyright (c) 2026",
    "app_version": "1.0.0",
    "utctime_updated": "2026-08-26T00:00:00.000000Z",
    "package_name": "phantom_efficientip_ddi_classic",
    "main_module": "efficientip_ddi_classic_connector.py",
    "min_phantom_version": "6.4.1",
    "app_wizard_version": "1.0.0",
    "python_version": "3.13",
    "pip_dependencies": {
        "wheel": []
    },
    "configuration": {
        "base_url": {
            "description": "Base URL of the APIM gateway fronting SOLIDserver, e.g. https://apim.internal.example",
            "data_type": "string",
            "required": true,
            "order": 0
        },
        "client_id": {
            "description": "APIM app client ID (sent as the Basic Auth username)",
            "data_type": "string",
            "required": true,
            "order": 1
        },
        "client_secret": {
            "description": "APIM app client secret (sent as the Basic Auth password)",
            "data_type": "password",
            "required": true,
            "order": 2
        },
        "ddi_username": {
            "description": "SOLIDserver backend username, forwarded through APIM via X-DDI-Username",
            "data_type": "string",
            "required": true,
            "order": 3
        },
        "ddi_password": {
            "description": "SOLIDserver backend password, forwarded through APIM via X-DDI-Password",
            "data_type": "password",
            "required": true,
            "order": 4
        },
        "ph_mtls": {
            "data_type": "ph",
            "order": 5
        },
        "client_cert": {
            "description": "PEM client certificate presented to APIM for mTLS",
            "data_type": "string",
            "required": true,
            "order": 6
        },
        "client_key": {
            "description": "PEM private key matching client_cert",
            "data_type": "password",
            "required": true,
            "order": 7
        },
        "client_ca": {
            "description": "PEM CA bundle to verify APIM's server certificate (optional -- blank uses system CAs)",
            "data_type": "string",
            "required": false,
            "order": 8
        },
        "verify_ssl": {
            "description": "Verify APIM's TLS server certificate",
            "data_type": "boolean",
            "required": false,
            "default": true,
            "order": 9
        }
    },
    "actions": [
        {
            "action": "test connectivity",
            "identifier": "test_connectivity",
            "description": "Validate the asset configuration for connectivity using supplied configuration (GET /rest/ip_block_subnet_list, bare)",
            "type": "test",
            "read_only": true,
            "parameters": {},
            "output": [],
            "versions": "EQ(*)"
        },
        {
            "action": "get ip address",
            "identifier": "get_ip_address",
            "description": "Look up an IP address in SOLIDserver's IPAM (subnet, space, status, hostname, MAC, class) for enrichment",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "address": {
                    "description": "IPv4/IPv6 address to look up in SOLIDserver's IPAM",
                    "data_type": "string",
                    "required": true,
                    "order": 0,
                    "contains": ["ip"]
                }
            },
            "output": [
                {"data_path": "action_result.parameter.address", "data_type": "string", "contains": ["ip"]},
                {"data_path": "action_result.data.*.address", "data_type": "string", "contains": ["ip"]},
                {"data_path": "action_result.data.*.ip_id", "data_type": "string"},
                {"data_path": "action_result.data.*.subnet", "data_type": "string"},
                {"data_path": "action_result.data.*.space", "data_type": "string"},
                {"data_path": "action_result.data.*.status", "data_type": "string"},
                {"data_path": "action_result.data.*.hostname", "data_type": "string", "contains": ["host name"]},
                {"data_path": "action_result.data.*.mac_address", "data_type": "string", "contains": ["mac address"]},
                {"data_path": "action_result.data.*.ddi_class", "data_type": "string"},
                {"data_path": "action_result.data.*.description", "data_type": "string"},
                {"data_path": "action_result.status", "data_type": "string", "example_values": ["success", "failed"]},
                {"data_path": "action_result.message", "data_type": "string"},
                {"data_path": "summary.total_objects", "data_type": "numeric"},
                {"data_path": "summary.total_objects_successful", "data_type": "numeric"}
            ],
            "render": {"type": "table"},
            "versions": "EQ(*)"
        },
        {
            "action": "list subnets",
            "identifier": "list_subnets",
            "description": "Look up a subnet in SOLIDserver's IPAM by name (parent, space, address range, size, class) for enrichment. Output field names follow ip_address_list's confirmed subnet_* conventions but ip_block_subnet_list's own field set is not independently vendor-confirmed -- check raw_json if a named field comes back empty.",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "name": {
                    "description": "Subnet name to look up in SOLIDserver's IPAM (e.g. '10.20.30.0/24')",
                    "data_type": "string",
                    "required": true,
                    "order": 0
                }
            },
            "output": [
                {"data_path": "action_result.parameter.name", "data_type": "string"},
                {"data_path": "action_result.data.*.subnet_id", "data_type": "string"},
                {"data_path": "action_result.data.*.subnet_name", "data_type": "string"},
                {"data_path": "action_result.data.*.parent_subnet", "data_type": "string"},
                {"data_path": "action_result.data.*.space", "data_type": "string"},
                {"data_path": "action_result.data.*.start_address", "data_type": "string", "contains": ["ip"]},
                {"data_path": "action_result.data.*.end_address", "data_type": "string", "contains": ["ip"]},
                {"data_path": "action_result.data.*.size", "data_type": "string"},
                {"data_path": "action_result.data.*.ddi_class", "data_type": "string"},
                {"data_path": "action_result.data.*.description", "data_type": "string"},
                {"data_path": "action_result.data.*.raw_json", "data_type": "string"},
                {"data_path": "action_result.status", "data_type": "string", "example_values": ["success", "failed"]},
                {"data_path": "action_result.message", "data_type": "string"},
                {"data_path": "summary.total_objects", "data_type": "numeric"},
                {"data_path": "summary.total_objects_successful", "data_type": "numeric"}
            ],
            "render": {"type": "table"},
            "versions": "EQ(*)"
        },
        {
            "action": "get ip pool",
            "identifier": "get_ip_pool",
            "description": "Look up an IP pool in SOLIDserver's IPAM by name for enrichment. Field names are inferred by analogy to ip_address_list's confirmed conventions, NOT independently vendor-confirmed -- check raw_json if a named field comes back empty.",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "name": {
                    "description": "Pool name to look up in SOLIDserver's IPAM",
                    "data_type": "string",
                    "required": true,
                    "order": 0
                }
            },
            "output": [
                {"data_path": "action_result.parameter.name", "data_type": "string"},
                {"data_path": "action_result.data.*.pool_id", "data_type": "string"},
                {"data_path": "action_result.data.*.pool_name", "data_type": "string"},
                {"data_path": "action_result.data.*.subnet", "data_type": "string"},
                {"data_path": "action_result.data.*.space", "data_type": "string"},
                {"data_path": "action_result.data.*.start_address", "data_type": "string", "contains": ["ip"]},
                {"data_path": "action_result.data.*.end_address", "data_type": "string", "contains": ["ip"]},
                {"data_path": "action_result.data.*.ddi_class", "data_type": "string"},
                {"data_path": "action_result.data.*.description", "data_type": "string"},
                {"data_path": "action_result.data.*.raw_json", "data_type": "string"},
                {"data_path": "action_result.status", "data_type": "string", "example_values": ["success", "failed"]},
                {"data_path": "action_result.message", "data_type": "string"},
                {"data_path": "summary.total_objects", "data_type": "numeric"},
                {"data_path": "summary.total_objects_successful", "data_type": "numeric"}
            ],
            "render": {"type": "table"},
            "versions": "EQ(*)"
        },
        {
            "action": "list aliases",
            "identifier": "list_aliases",
            "description": "List DNS aliases for a known SOLIDserver ip_id (chain off 'get ip address' output). Field names are inferred, NOT independently vendor-confirmed -- check raw_json if alias_name comes back empty.",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "ip_id": {
                    "description": "Internal SOLIDserver ip_id of the address to list aliases for (from 'get ip address' output)",
                    "data_type": "numeric",
                    "required": true,
                    "order": 0
                }
            },
            "output": [
                {"data_path": "action_result.parameter.ip_id", "data_type": "numeric"},
                {"data_path": "action_result.data.*.ip_id", "data_type": "string"},
                {"data_path": "action_result.data.*.alias_name", "data_type": "string", "contains": ["host name"]},
                {"data_path": "action_result.data.*.raw_json", "data_type": "string"},
                {"data_path": "action_result.status", "data_type": "string", "example_values": ["success", "failed"]},
                {"data_path": "action_result.message", "data_type": "string"},
                {"data_path": "summary.total_objects", "data_type": "numeric"},
                {"data_path": "summary.total_objects_successful", "data_type": "numeric"}
            ],
            "render": {"type": "table"},
            "versions": "EQ(*)"
        }
    ]
}
