        {
            "action": "get ip address",
            "identifier": "get_ip_address",
            "description": "Look up an IP address in SOLIDserver's IPAM (subnet, space, status, hostname, MAC, class) for enrichment. Named fields are best-effort -- raw_json is the reliable source of truth, since these have been wrong under manual mapping more than once (e.g. hostname was hostdev_name until confirmed otherwise).",
            "type": "investigate",
            "read_only": true,
            "versions": "EQ(*)",
            "verbose": "",
            "parameters": {
                "address": {
                    "order": 0,
                    "name": "address",
                    "description": "IPv4/IPv6 address to look up in SOLIDserver's IPAM.",
                    "data_type": "string",
                    "required": true,
                    "primary": false,
                    "allow_list": false,
                    "contains": [
                        "ip"
                    ]
                },
                "limit": {
                    "order": 1,
                    "name": "limit",
                    "description": "Maximum number of records to return (default 1). Must be a positive whole number -- an unbounded call times out server-side on the real APIM, so a limit always goes on the wire.",
                    "data_type": "numeric",
                    "required": false,
                    "primary": false,
                    "allow_list": false,
                    "default": 1
                }
            },
