                            "drop_none": true,
                            "customName": "format enrichment summary",
                            "customNameId": 0
                        },
                        "template": "# EfficientIP DDI Enrichment\n\n**IP Address:** {0}\n**Lookup Status:** {1}\n**Hostname:** {2}\n**Subnet:** {3}\n**Space:** {4}\n**MAC Address:** {5}\n**Class:** {6}\n**Description:** {7}\n\n**Alias:** {8}",
                        "functionId": 5,
