    "configuration": {
        "base_url": {
            "data_type": "string",
            "required": true,
            "description": "Base URL of the APIM gateway fronting SOLIDserver, e.g. https://apim.internal.example",
            "order": 0,
            "category": "connectivity"
        },
        "client_id": {
            "data_type": "string",
            "required": true,
            "description": "APIM app client ID (sent as the Basic Auth username).",
            "order": 1,
            "category": "connectivity"
        },
        "client_secret": {
            "data_type": "password",
            "required": true,
            "description": "APIM app client secret (sent as the Basic Auth password).",
            "order": 2,
            "category": "connectivity"
        },
        "ddi_username": {
            "data_type": "string",
            "required": true,
            "description": "SOLIDserver backend username, forwarded through APIM via X-DDI-Username.",
            "order": 3,
            "category": "connectivity"
        },
        "ddi_password": {
            "data_type": "password",
            "required": true,
            "description": "SOLIDserver backend password, forwarded through APIM via X-DDI-Password.",
            "order": 4,
            "category": "connectivity"
        },
        "client_cert": {
            "data_type": "password",
            "required": true,
            "description": "PEM client certificate presented to APIM for mTLS.",
            "order": 5,
            "category": "connectivity"
        },
        "client_key": {
            "data_type": "password",
            "required": true,
            "description": "PEM private key matching client_cert.",
            "order": 6,
            "category": "connectivity"
        },
        "client_ca": {
            "data_type": "password",
            "required": false,
            "description": "PEM CA bundle to verify APIM's server certificate (optional \u2014 leave blank to use system CAs).",
            "order": 7,
            "category": "connectivity",
            "default": ""
        },
        "verify_ssl": {
            "data_type": "boolean",
            "required": true,
            "description": "Verify APIM's TLS server certificate.",
            "order": 8,
            "category": "connectivity",
            "default": true
        }
    },
