{
    "appid": "33986f6c-2005-4c3a-aa8b-d7a83caa76d0",
    "name": "EfficientIP DDI",
    "description": "Analyst-driven IP/DNS lookup enrichment against an EfficientIP SOLIDserver DDI backend reached through an APIM gateway. Provides IPAM address lookup, alias, subnet and pool queries over mTLS with Basic APIM credentials and forwarded SOLIDserver credentials.",
    "type": "ddi",
    "product_vendor": "EfficientIP",
    "product_name": "SOLIDserver",
    "product_version_regex": ".*",
    "logo": "logo.svg",
    "logo_dark": "logo_dark.svg",
    "publisher": "Ted",
    "license": "Copyright (c) 2026",
    "app_version": "1.0.6",
    "utctime_updated": "2026-08-26T00:00:00.000000Z",
    "package_name": "phantom_efficientip_ddi",
    "main_module": "efficientip_ddi_connector.py",
    "min_phantom_version": "6.4.1",
    "app_wizard_version": "1.0.0",
    "python_version": "3.13",
    "pip_dependencies": {
        "wheel": []
    },
    "configuration": {
        "base_url": {
            "description": "Base URL of the APIM gateway fronting SOLIDserver, e.g. https://apim.internal.example",
            "data_type": "string",
            "required": true,
            "order": 0
        },
        "client_id": {
            "description": "APIM app client ID (sent as the Basic Auth username)",
            "data_type": "string",
            "required": true,
            "order": 1
        },
        "client_secret": {
            "description": "APIM app client secret (sent as the Basic Auth password)",
            "data_type": "password",
            "required": true,
            "order": 2
        },
        "ddi_username": {
            "description": "SOLIDserver backend username, forwarded through APIM via X-DDI-Username",
            "data_type": "string",
            "required": true,
            "order": 3
        },
        "ddi_password": {
            "description": "SOLIDserver backend password, forwarded through APIM via X-DDI-Password",
            "data_type": "password",
            "required": true,
            "order": 4
        },
        "ph_mtls": {
            "data_type": "ph",
            "order": 5
        },
        "client_cert": {
            "description": "PEM client certificate presented to APIM for mTLS",
            "data_type": "string",
            "required": true,
            "order": 6
        },
        "client_key": {
            "description": "PEM private key matching client_cert",
            "data_type": "password",
            "required": true,
            "order": 7
        },
        "client_ca": {
            "description": "PEM CA bundle to verify APIM's server certificate (optional -- blank uses system CAs)",
            "data_type": "string",
            "required": false,
            "order": 8
        },
        "verify_ssl": {
            "description": "Verify APIM's TLS server certificate",
            "data_type": "boolean",
            "required": false,
            "default": true,
            "order": 9
        },
        "retry_count": {
            "description": "Total attempts for a request that returns HTTP 401 (1 = no retry)",
            "data_type": "numeric",
            "required": false,
            "default": 3,
            "order": 10
        },
        "retry_backoff": {
            "description": "Base seconds to wait between 401 retries; the wait grows linearly (1x, 2x, 3x)",
            "data_type": "numeric",
            "required": false,
            "default": 2,
            "order": 11
        },
        "user_agent": {
            "description": "User-Agent header. Defaults to a curl string, matching the client known to work against this APIM; blank keeps the HTTP library default",
            "data_type": "string",
            "required": false,
            "default": "curl/8.4.0",
            "order": 12
        }
    },
    "actions": [
        {
            "action": "test connectivity",
            "identifier": "test_connectivity",
            "description": "Validate the asset configuration for connectivity using supplied configuration (GET /rest/ip_block_subnet_list, bare)",
            "type": "test",
            "read_only": true,
            "parameters": {},
            "output": [],
            "versions": "EQ(*)"
        },
        {
            "action": "get ip address",
            "identifier": "get_ip_address",
            "description": "Look up an IP address in SOLIDserver's IPAM (subnet, space, status, hostname, MAC, class) for enrichment",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "address": {
                    "description": "IPv4/IPv6 address to look up in SOLIDserver's IPAM",
                    "data_type": "string",
                    "required": true,
                    "order": 0,
                    "contains": [
                        "ip"
                    ]
                },
                "limit": {
                    "description": "Maximum number of records to return (default 1). Must be a positive whole number -- an unbounded call times out server-side on the real APIM, so a limit always goes on the wire.",
                    "data_type": "numeric",
                    "required": false,
                    "default": 1,
                    "order": 1
                }
            },
            "output": [
                {
                    "data_path": "action_result.parameter.address",
                    "data_type": "string",
                    "contains": [
                        "ip"
                    ]
                },
                {
                    "data_path": "action_result.parameter.limit",
                    "data_type": "numeric"
                },
                {
                    "data_path": "action_result.data.*.address",
                    "data_type": "string",
                    "contains": [
                        "ip"
                    ]
                },
                {
                    "data_path": "action_result.data.*.ip_id",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.ip_addr",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.subnet_name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.site_name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.multistatus",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.name",
                    "data_type": "string",
                    "contains": [
                        "host name"
                    ]
                },
                {
                    "data_path": "action_result.data.*.mac_addr",
                    "data_type": "string",
                    "contains": [
                        "mac address"
                    ]
                },
                {
                    "data_path": "action_result.data.*.ip_class_name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.ip_class_parameters",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.description",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.status",
                    "data_type": "string",
                    "example_values": [
                        "success",
                        "failed"
                    ]
                },
                {
                    "data_path": "action_result.message",
                    "data_type": "string"
                },
                {
                    "data_path": "summary.total_objects",
                    "data_type": "numeric"
                },
                {
                    "data_path": "summary.total_objects_successful",
                    "data_type": "numeric"
                }
            ],
            "render": {
                "type": "table"
            },
            "versions": "EQ(*)"
        },
        {
            "action": "list subnets",
            "identifier": "list_subnets",
            "description": "Look up subnets in SOLIDserver's IPAM (parent, space, address range, size, class) for enrichment. Only 'limit' need be set: with no filter this lists subnets bare, the same shape test connectivity uses. Optionally set AT MOST ONE filter: subnet_name, subnet_id, parent_subnet_name (lists the subnets under a parent) or site_name (lists the subnets in a space). Raise 'limit' above the default of 1 to see more than one row, which the parent/site filters and the unfiltered call usually need. Output field names follow ip_address_list's confirmed subnet_* conventions but ip_block_subnet_list's own field set is not independently vendor-confirmed -- check raw_json if a named field comes back empty.",
            "type": "investigate",
            "read_only": true,
            "parameters": {
                "subnet_name": {
                    "description": "Filter by subnet NAME -- the human label the subnet carries in IPAM (e.g. 'Corporate-LAN'), not its CIDR. To find a subnet by address you need the range columns, which this action does not yet expose.",
                    "data_type": "string",
                    "required": false,
                    "order": 0
                },
                "subnet_id": {
                    "description": "Filter by SOLIDserver subnet id",
                    "data_type": "string",
                    "required": false,
                    "order": 1
                },
                "parent_subnet_name": {
                    "description": "Filter by parent subnet name -- lists the subnets underneath it",
                    "data_type": "string",
                    "required": false,
                    "order": 2
                },
                "site_name": {
                    "description": "Filter by space/site name -- lists the subnets belonging to it. Filters on the API's 'parent_site_name' column.",
                    "data_type": "string",
                    "required": false,
                    "order": 3
                },
                "limit": {
                    "description": "Maximum number of records to return (default 1). Must be a positive whole number -- an unbounded call times out server-side on the real APIM, so a limit always goes on the wire.",
                    "data_type": "numeric",
                    "required": false,
                    "default": 1,
                    "order": 4
                }
            },
            "output": [
                {
                    "data_path": "action_result.parameter.name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.parameter.limit",
                    "data_type": "numeric"
                },
                {
                    "data_path": "action_result.data.*.subnet_id",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.parent_subnet_name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.site_name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.tree_path",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.subnet_start_ip_addr",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.subnet_end_ip_addr",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.subnet_size",
                    "data_type": "numeric"
                },
                {
                    "data_path": "action_result.data.*.subnet_class_name",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.subnet_class_parameters",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.data.*.description",
                    "data_type": "string"
                },
                {
                    "data_path": "action_result.status",
                    "data_type": "string",
                    "example_values": [
                        "success",
                        "failed"
                    ]
                },
                {
                    "data_path": "action_result.message",
                    "data_type": "string"
                },
                {
                    "data_path": "summary.total_objects",
                    "data_type": "numeric"
                },
                {
                    "data_path": "summary.total_objects_successful",
                    "data_type": "numeric"
                }
            ],
            "render": {
                "type": "table"
            },
            "versions": "EQ(*)"
        },
        {
